APP_ENV=production
LOG_LEVEL=info
# Required. The absolute public origin users browse to, for example
# https://transcripts.example.com . Links, cookies, and passkeys derive from it.
PUBLIC_BASE_URL=https://transcripts.example.com
TRUST_PROXY=127.0.0.1
# Keep the cleartext backend local when the reverse proxy runs on this host.
HOST_BIND_ADDRESS=127.0.0.1
# Optional overrides. Keep these stable after registering the first passkey.
PASSKEY_RP_ID=
PASSKEY_ORIGINS=
TRANSCRIPT_STORAGE_LIMIT_BYTES=10737418240

# Optional transcript API tokens (comma-separated). Configured values are
# restored on startup, so remove them here before revoking them in the admin UI.
API_TOKENS=
RATE_LIMIT_MAX=25
RATE_LIMIT_WINDOW_MS=60000
TRANSCRIPT_LIMIT=1000

# Container user. These defaults match a typical unprivileged Linux account.
PUID=1000
PGID=1000
